{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "esModuleInterop": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
    },
    "rootDir": ".",
    "declaration": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "strict": true
  },
  "include": [
    "src/**/*",
    "ktr/**/*",
    "karin.template.ts",
  ],
  "exclude": [
    "node_modules",
  ]
}
